# ============================================================================
# 地球OL · Caddy 站点（一条命令栈的对外面孔）
#
# SITE_ADDRESS 由 compose 从环境（.env）传入：
#   没有域名时默认 ":80" —— 纯 HTTP 跑在所有主机名上，先用 IP 验证；
#   填上域名（SITE_ADDRESS=earth.example.com）→ 自动申请并续期证书，
#   80 自动重定向到 443。证书数据在 caddy_data 卷里，升级不重签。
#
# 反代目标是 compose 内网的 earthonline 服务 ——
# 应用容器不对宿主机开端口，对外只有 Caddy 这一个入口。
# ============================================================================

{$SITE_ADDRESS} {
  # 云同步：/sync/* 原样转给同步容器。
  # 前缀**不剥** —— 服务端路由的字面量就是 /sync/v1/...（见 server/index.mjs）。
  # 块序有讲究：handle 互斥且**按书写次序**判定，所以前缀那条在前、兜底在最后。
  handle /sync/* {
    reverse_proxy sync:3000
  }

  # 其余一切：应用（nginx 静态）——对外仍然只有这一个域名、一个证书
  handle {
    reverse_proxy earthonline:80
  }
}
